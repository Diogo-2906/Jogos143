    <style>

        .Titulo-Classes {
        margin-bottom: 2rem;
        font-family: "Ultra", serif;
        font-style: normal;
        }


            /*Caroussel*/
        .game-carousel {
            width: 100%;
            height: 420px;
            background: rgba(48, 0, 80, 0.35);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 0;
            margin-bottom:5rem;
        }

        .carousel-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.5s ease;
        }

        .slide {
            min-width: 100%;
            display: flex;
            gap: 20px;
            padding: 10px;
        }

        .slide-video {
            width: 60%;
            height: 390px;
            object-fit: cover;
            border-radius: 8px;
        }

        .slide-info {
            padding: 20px;
            width: 40%;
            color: white;
        }

        .slide-info p {
            margin-top: 2rem;
        }

         .btn-jogo, .btn-carrinho {
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        border: none;
        margin-top: 10%;
        font-size: 1rem;
        cursor: pointer;
        color: white;
        transition: 0.3s;
    }

        .btn-jogo {
            background: linear-gradient(90deg, #a85eff, #873bff);
            box-shadow: 0 0 12px rgba(168,94,255,0.6);
        }

            .btn-jogo:hover {
                transform: scale(1.03);
                box-shadow: 0 0 22px rgba(168,94,255,1);
            }

        .nav-btn {
            z-index: 9999;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.4);
            border: none;
            color: white;
            font-size: 40px;
            padding: 10px;
            cursor: pointer;
            border-radius: 8px;
        }

        .prev-btn {
            left: 10px;
        }

        .next-btn {
            right: 10px;
        }

        .nav-btn:hover {
            background: rgba(0,0,0,0.6);
        }


    </style>


    
            
              <script>
        const track = document.querySelector(".carousel-track");
        const slides = document.querySelectorAll(".slide");
        let index = 0;

        function updateSlide() {
            track.style.transform = `translateX(${index * -100}%)`;
        }

        document.querySelector(".next-btn").onclick = () => {
            index = (index + 1) % slides.length;
            updateSlide();
        };

        document.querySelector(".prev-btn").onclick = () => {
            index = (index - 1 + slides.length) % slides.length;
            updateSlide();
        };

    </script>




    

    
