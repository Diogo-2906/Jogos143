    <style>

            /*Caroussel*/
        .game-carousel {
            width: 100%;
            height: 420px;
            background: linear-gradient(to right, #0a1b2b, #132c46);
            border-radius: 10px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 0;
        }

        .carousel-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.5s ease;
        }

        .slide {
            min-width: 100%;
            display: flex;
            gap: 20px;
            padding: 10px;
        }

        .slide-img {
            width: 60%;
            height: 390px;
            object-fit: cover;
            border-radius: 8px;
        }

        .slide-info {
            width: 40%;
            color: white;
        }

        .mini-images {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

            .mini-images img {
                width: 100%;
                height: 85px;
                object-fit: cover;
                border-radius: 6px;
            }

        .nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.4);
            border: none;
            color: white;
            font-size: 40px;
            padding: 10px;
            cursor: pointer;
            border-radius: 8px;
        }

        .prev-btn {
            left: 10px;
        }

        .next-btn {
            right: 10px;
        }

        .nav-btn:hover {
            background: rgba(0,0,0,0.6);
        }


    </style>


    
            
              <script>
        const track = document.querySelector(".carousel-track");
        const slides = document.querySelectorAll(".slide");
        let index = 0;

        function updateSlide() {
            track.style.transform = `translateX(${index * -100}%)`;
        }

        document.querySelector(".next-btn").onclick = () => {
            index = (index + 1) % slides.length;
            updateSlide();
        };

        document.querySelector(".prev-btn").onclick = () => {
            index = (index - 1 + slides.length) % slides.length;
            updateSlide();
        };
    </script>




    

    
